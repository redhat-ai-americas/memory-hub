{
  "name": "@memory-hub/opencode-mh-plugin",
  "version": "0.1.0",
  "description": "MemoryHub memory plugin for opencode — governed, versioned, graph-aware agent memory with semantic search and multi-scope hierarchy.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "memoryhub-rules.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opencode-ai/plugin": "^1.18.25"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "license": "Apache-2.0"
}
